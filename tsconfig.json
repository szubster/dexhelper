{
  "extends": [
    "@tsconfig/vite-react/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@dexhelper/engine": ["./packages/engine/src/index.ts"],
      "@dexhelper/engine/*": ["./packages/engine/src/*"]
    },
    "incremental": true,
    "types": ["@types/wicg-file-system-access"]
  },
  "exclude": ["packages/foundry"]
}
