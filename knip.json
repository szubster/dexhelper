{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["src/engine/data/gen2/wildModels.ts"],
  "ignoreDependencies": [
    "wrangler",
    "@cloudflare/pages-plugin-cloudflare-access",
    "@tsconfig/strictest",
    "@tsconfig/vite-react"
  ],
  "ignore": [
    "src/features/decorations/types.ts",
    "src/test-setup.ts",
    "src/engine/data/gen2/wildModels.ts",
    "src/contexts/binjgb/index.ts",
    "src/hooks/useBinjgb.ts",
    ".github/scripts/extract-research.ts",
    "scripts/gen3-fetch-locations.ts",
    "functions/_middleware.ts",
    "functions/api/saves/index.ts",
    "functions/api/saves/[id].ts",
    "functions/utils/google-drive-auth.ts",
    "src/engine/saveParser/utils/index.ts",
    ".github/scripts/aggregate-journals.ts",
    ".github/scripts/archival-filtering.ts",
    ".github/scripts/update-idea-matrix.ts",
    "src/engine/saveParser/parsers/gen2.ts",
    "src/utils/hof/index.ts",
    ".github/scripts/generate-statistics.ts",
    "src/engine/exclusives/gen3Exclusives.ts",
    ".github/scripts/schema.ts",
    "src/features/pathfinder/**",
    "src/utils/pagination/index.ts",
    "benchmarks/**",
    "tests/benchmarks/**"
  ],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error"
  }
}
