{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "wrangler",
    "@cloudflare/pages-plugin-cloudflare-access"
  ],
  "ignore": [
    "src/test-setup.ts",
    "src/engine/data/gen2/wildModels.ts",
    "src/contexts/binjgb/index.ts",
    "src/hooks/useBinjgb.ts",
    ".github/scripts/extract-research.ts",
    "scripts/gen3-fetch-locations.ts",
    "functions/_middleware.ts",
    "functions/api/saves/index.ts",
    "functions/api/saves/[id].ts",
    "src/engine/saveParser/utils/index.ts",
    ".github/scripts/aggregate-journals.ts",
    ".github/scripts/update-idea-matrix.ts",
    ".github/scripts/schema.ts",
    ".github/scripts/session-api.ts",
    ".github/scripts/blocked-diagnosis.ts",
    "src/utils/hof/index.ts",
    ".github/scripts/generate-statistics.ts",
    "src/features/pathfinder/**",
    "src/utils/pagination/index.ts",
    "benchmarks/**",
    "tests/benchmarks/**",
    "scripts/migrate-task-reminders.ts",
    ".foundry/scripts/lint-schema.ts",
    "src/engine/gen3/contests/index.ts",
    "src/engine/gen3/contests/constants.ts",
    "src/engine/radar/index.ts",
    "src/engine/saveParser/parsers/gen2Constants.ts",
    "tests/e2e/fixtures/mock-foundry.ts",
    "tests/e2e/fixtures/index.ts",
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error"
  }
}