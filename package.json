{
  "name": "dexhelper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "check:biome": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --unsafe .",
    "clean": "rm -rf dist",
    "data:gen": "node --experimental-strip-types scripts/generate-pokedata.ts",
    "data:gen-maps": "node --experimental-strip-types scripts/generateMapLocations.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "format:biome": "biome format .",
    "postinstall": "lefthook install || true",
    "knip": "knip",
    "lint": "pnpm type-check && pnpm check:biome && pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check . && pnpm knip && pnpm lint:circular && pnpm lint:package-json",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:ci": "pnpm lint",
    "lint:circular": "dpdm --circular --no-warning --no-tree src/main.tsx",
    "lint:oxlint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check .",
    "lint:package-json": "sort-package-json --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bundle": "bundlemon",
    "test:coverage": "vitest run --coverage",
    "test:ct": "vitest --project browser",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:xvfb": "xvfb-run -a playwright test",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-virtual": "3.14.10",
    "@xyflow/react": "^12.11.5",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dataloader": "^2.2.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.38.0",
    "msgpackr": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-plugin": "^1.168.35",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "browserslist": "^4.28.8",
    "bundlemon": "^3.1.0",
    "dpdm": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sort-package-json": "^4.0.0",
    "tailwindcss": "4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.21.0"
  }
}
