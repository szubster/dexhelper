{
  "name": "dexhelper",
  "version": "0.0.0",
  "private": true,
  "description": "Dexhelper is a React-based web application designed as a Pokédex helper, likely for older generations of Pokémon games (Gen 1 and Gen 2). It includes features for parsing game saves, providing assistance for catching Pokémon, and viewing Pokémon details.",
  "keywords": [],
  "homepage": "https://github.com/szubster/dexhelper#readme",
  "bugs": {
    "url": "https://github.com/szubster/dexhelper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szubster/dexhelper.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "antigravity": "node --experimental-strip-types packages/antigravity-orchestrator/cli.ts",
    "antigravity:assign": "pnpm antigravity assign",
    "antigravity:dispatch": "pnpm antigravity dispatch",
    "antigravity:reconcile": "pnpm antigravity reconcile",
    "antigravity:status": "pnpm antigravity status",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "check:biome": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --unsafe .",
    "clean": "rm -rf dist",
    "data:gen": "node --experimental-strip-types scripts/generate-pokedata.ts",
    "data:gen-maps": "node --experimental-strip-types scripts/generateMapLocations.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "feature-flag": "node --experimental-strip-types scripts/feature-flags/cli.ts",
    "format": "pnpm format:biome && pnpm format:checkboxes",
    "format:biome": "biome format .",
    "format:checkboxes": "node --experimental-strip-types packages/foundry/utils/format-checkboxes.ts",
    "postinstall": "lefthook install || true",
    "knip": "knip",
    "lint": "pnpm type-check && pnpm check:biome && pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check . && pnpm knip && pnpm lint:circular && pnpm lint:deps && pnpm lint:foundry && pnpm lint:package-json && pnpm lint:adr",
    "lint:adr": "node --experimental-strip-types scripts/verify-adr-compliance.ts",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:ci": "pnpm lint",
    "lint:circular": "dpdm --circular --no-warning --no-tree src/main.tsx",
    "lint:deps": "depcruise src packages",
    "lint:foundry": "node --experimental-strip-types scripts/validate-foundry-schema.ts",
    "lint:oxlint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check .",
    "lint:package-json": "sort-package-json --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bench": "node --experimental-strip-types tests/benchmarks/run-benchmarks.ts",
    "test:bundle": "bundlemon",
    "test:coverage": "vitest run --coverage",
    "test:ct": "vitest --project browser",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:xvfb": "xvfb-run -a playwright test",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "verify:refs": "pnpm --filter @dexhelper/foundry verify:refs"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "@dexhelper/ui": "workspace:*",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-virtual": "3.14.24",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "dataloader": "^2.2.3",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.4",
    "lucide-react": "^1.65.0",
    "msgpackr": "^2.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@biomejs/biome": "~2.6.4",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@codecov/vite-plugin": "^2.0.1",
    "@dexhelper/vite-plugins": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "browserslist": "^4.29.5",
    "bundlemon": "^3.2.0",
    "dependency-cruiser": "^18.7.0",
    "dpdm": "^4.3.0",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sort-package-json": "^4.1.0",
    "tailwindcss": "4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.16.1"
  }
}
