{
  "name": "dexhelper-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dexhelper/web build",
    "build:analyze": "pnpm --filter @dexhelper/web build:analyze",
    "check:biome": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --unsafe .",
    "clean": "pnpm --recursive run clean",
    "data:gen": "pnpm --filter @dexhelper/pokedata data:gen",
    "data:gen-maps": "pnpm --filter @dexhelper/pokedata data:gen-maps",
    "dev": "pnpm --filter @dexhelper/web dev",
    "format:biome": "biome format .",
    "postinstall": "lefthook install || true",
    "knip": "knip",
    "lint": "pnpm type-check && pnpm check:biome && pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check . && pnpm knip && pnpm lint:circular && pnpm lint:package-json",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:ci": "pnpm lint",
    "lint:circular": "madge --circular --extensions ts,tsx ./apps/web/src",
    "lint:oxlint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check .",
    "lint:package-json": "sort-package-json --check",
    "preview": "pnpm --filter @dexhelper/web preview",
    "test": "vitest run",
    "test:bundle": "bundlemon",
    "test:coverage": "vitest run --coverage",
    "test:ct": "pnpm --filter @dexhelper/web test:ct",
    "test:e2e": "pnpm --filter @dexhelper/web test:e2e",
    "test:e2e:ui": "pnpm --filter @dexhelper/web test:e2e:ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@biomejs/biome": "^2.5.8",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "madge": "^8.0.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rollup-plugin-visualizer": "^7.1.1",
    "sort-package-json": "^4.0.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.21.0"
  }
}
