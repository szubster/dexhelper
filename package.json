{
  "name": "dexhelper",
  "version": "0.0.0",
  "private": true,
  "description": "Dexhelper is a React-based web application designed as a Pokédex helper, likely for older generations of Pokémon games (Gen 1 and Gen 2). It includes features for parsing game saves, providing assistance for catching Pokémon, and viewing Pokémon details.",
  "keywords": [],
  "homepage": "https://github.com/szubster/dexhelper#readme",
  "bugs": {
    "url": "https://github.com/szubster/dexhelper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szubster/dexhelper.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "check:biome": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --unsafe .",
    "clean": "rm -rf dist",
    "data:gen": "node --experimental-strip-types scripts/generate-pokedata.ts",
    "data:gen-maps": "node --experimental-strip-types scripts/generateMapLocations.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "feature-flag": "node --experimental-strip-types scripts/feature-flags/cli.ts",
    "format": "pnpm format:biome && pnpm format:checkboxes",
    "format:biome": "biome format .",
    "format:checkboxes": "node --experimental-strip-types .github/scripts/utils/format-checkboxes.ts",
    "postinstall": "lefthook install || true",
    "knip": "knip",
    "lint": "pnpm type-check && pnpm check:biome && pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check . && pnpm knip && pnpm lint:circular && pnpm lint:deps && pnpm lint:package-json",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:ci": "pnpm lint",
    "lint:circular": "dpdm --circular --no-warning --no-tree src/main.tsx",
    "lint:deps": "depcruise src packages",
    "lint:oxlint": "pnpm exec oxlint -c .oxlintrc.json --type-aware --type-check .",
    "lint:package-json": "sort-package-json --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bench": "node --experimental-strip-types tests/benchmarks/run-benchmarks.ts",
    "test:bundle": "bundlemon",
    "test:coverage": "vitest run --coverage",
    "test:ct": "vitest --project browser",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:xvfb": "xvfb-run -a playwright test",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dagre": "^0.8.5",
    "dataloader": "^2.2.3",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "msgpackr": "^2.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "browserslist": "^4.29.0",
    "bundlemon": "^3.1.0",
    "dependency-cruiser": "^18.4.0",
    "dpdm": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sort-package-json": "^4.0.0",
    "tailwindcss": "4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.132.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.21.0"
  }
}
