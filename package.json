{
  "name": "dexhelper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "check:biome": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --unsafe .",
    "clean": "rm -rf dist",
    "data:gen": "node --experimental-strip-types scripts/generate-pokedata.ts",
    "data:gen-maps": "node --experimental-strip-types scripts/generateMapLocations.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "format:biome": "biome format .",
    "postinstall": "lefthook install || true",
    "knip": "knip",
    "lint": "pnpm type-check && pnpm check:biome && pnpm exec oxlint --type-aware --type-check --import-plugin --promise-plugin . && pnpm knip && pnpm lint:circular && pnpm lint:package-json",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:circular": "madge --circular --extensions ts,tsx ./src",
    "lint:package-json": "sort-package-json --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bundle": "bundlemon",
    "test:coverage": "vitest run --coverage",
    "test:ct": "vitest --project browser",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dataloader": "^2.2.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.23.0",
    "msgpackr": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@biomejs/biome": "^2.5.4",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-plugin": "^1.168.23",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.0.6",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "browserslist": "^4.28.6",
    "bundlemon": "^3.1.0",
    "fake-indexeddb": "^6.2.5",
    "knip": "^6.27.0",
    "lefthook": "^2.1.10",
    "lightningcss": "^1.32.0",
    "madge": "^8.0.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "^1.62.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sort-package-json": "^4.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.113.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.9.0"
  }
}
