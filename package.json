{
  "name": "dexhelper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "check:biome": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --unsafe .",
    "clean": "rm -rf dist",
    "data:gen": "node --experimental-strip-types scripts/generate-pokedata.ts",
    "data:gen-maps": "node --experimental-strip-types scripts/generateMapLocations.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "format:biome": "biome format .",
    "postinstall": "lefthook install",
    "knip": "knip",
    "lint": "pnpm type-check && pnpm check:biome && pnpm exec oxlint --type-aware --type-check --import-plugin --promise-plugin . && pnpm knip && pnpm lint:circular && pnpm lint:package-json",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:circular": "madge --circular --extensions ts,tsx ./src",
    "lint:package-json": "sort-package-json --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bundle": "bundlemon",
    "test:coverage": "vitest run --coverage",
    "test:ct": "vitest --project browser",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dataloader": "^2.2.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "msgpackr": "^2.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.0.2",
    "@biomejs/biome": "^2.4.15",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/router-plugin": "^1.168.11",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.0.6",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "browserslist": "^4.28.2",
    "bundlemon": "^3.1.0",
    "fake-indexeddb": "^6.2.5",
    "gray-matter": "^4.0.3",
    "knip": "^6.14.2",
    "lefthook": "^2.1.8",
    "lightningcss": "^1.32.0",
    "madge": "^8.0.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sort-package-json": "^3.6.1",
    "tailwindcss": "4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.94.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp"
    ],
    "auditConfig": {
      "ignoreCves": [
        "GHSA-rmmr-r34h-pfm5"
      ]
    }
  }
}
