{
  "subProject": "app",
  "baseDir": "./dist",
  "pathLabels": {
    "hash": "[a-zA-Z0-9-_]+"
  },
  "defaultCompression": "none",
  "files": [
    {
      "path": "index.html",
      "maxSize": "5kb"
    },
    {
      "path": "assets/index-<hash>.js",
      "maxSize": "130kb"
    },
    {
      "path": "assets/index-<hash>.css",
      "maxSize": "235kb"
    },
    {
      "path": "assets/react-<hash>.js",
      "maxSize": "250kb"
    },
    {
      "path": "assets/router-<hash>.js",
      "maxSize": "90kb"
    },
    {
      "path": "assets/query-<hash>.js",
      "maxSize": "50kb"
    },
    {
      "path": "assets/msgpackr-<hash>.js",
      "maxSize": "35kb"
    },
    {
      "path": "assets/press-*<hash>.css",
      "maxSize": "100kb"
    },
    {
      "path": "assets/*-<hash>.css",
      "maxSize": "150kb"
    },
    {
      "path": "assets/ui-primitives-<hash>.js",
      "maxSize": "55kb"
    },
    {
      "path": "assets/assistant-<hash>.js",
      "maxSize": "75kb"
    },
    {
      "path": "assets/safariZone-<hash>.js",
      "maxSize": "55kb"
    },
    {
      "path": "assets/routes-<hash>.js",
      "maxSize": "45kb"
    },
    {
      "path": "assets/esm-<hash>.js",
      "maxSize": "40kb"
    },
    {
      "path": "assets/dist-<hash>.js",
      "maxSize": "35kb"
    },
    {
      "path": "assets/gen3-<hash>.js",
      "maxSize": "40kb"
    },
    {
      "path": "assets/gen3-dashboard-<hash>.js",
      "maxSize": "30kb"
    },
    {
      "path": "assets/pokemon._pokemonId-<hash>.js",
      "maxSize": "30kb"
    },
    {
      "path": "assets/*Dashboard-<hash>.js",
      "maxSize": "20kb"
    },
    {
      "path": "assets/*-<hash>.js",
      "maxSize": "25kb"
    },
    {
      "path": "data/foundry.json",
      "maxSize": "870kb"
    },
    {
      "path": "data/pokedata-core.msgpack",
      "maxSize": "600kb"
    },
    {
      "path": "icon-512.png",
      "maxSize": "520kb"
    },
    {
      "path": "icon-192.png",
      "maxSize": "50kb"
    },
    {
      "path": "workbox-<hash>.js",
      "maxSize": "50kb"
    },
    {
      "path": "sw.js",
      "maxSize": "15kb"
    },
    {
      "path": "**/*.@(js|css|html|png|msgpack|webmanifest|json|hash|txt)",
      "maxSize": "300kb"
    }
  ],
  "reportOutput": [
    [
      "github",
      {
        "checkRun": true,
        "commitStatus": true,
        "prComment": true
      }
    ]
  ]
}
