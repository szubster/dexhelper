{
  "baseDir": "./dist",
  "pathLabels": {
    "hash": "[a-zA-Z0-9-_]+"
  },
  "defaultCompression": "none",
  "files": [
    {
      "path": "assets/index-<hash>.js",
      "maxSize": "320kb"
    },
    {
      "path": "assets/query-<hash>.js",
      "maxSize": "50kb"
    },
    {
      "path": "assets/icons-<hash>.js",
      "maxSize": "50kb"
    },
    {
      "path": "assets/dag-<hash>.js",
      "maxSize": "100kb"
    },
    {
      "path": "assets/react-<hash>.js",
      "maxSize": "250kb"
    },
    {
      "path": "assets/router-<hash>.js",
      "maxSize": "100kb"
    },
    {
      "path": "assets/xyflow-<hash>.js",
      "maxSize": "200kb"
    },
    {
      "path": "assets/style-<hash>.css",
      "maxSize": "165kb"
    },
    {
      "path": "data/pokedata.msgpack",
      "maxSize": "800kb"
    },
    {
      "path": "workbox-<hash>.js",
      "maxSize": "50kb"
    },
    {
      "path": "assets/*.map",
      "maxSize": "1500kb"
    },
    {
      "path": "**/*",
      "maxSize": "500kb"
    }
  ],
  "reportOutput": [
    [
      "github",
      {
        "checkRun": true,
        "commitStatus": true,
        "prComment": true
      }
    ]
  ]
}