{
  "baseDir": "./dist",
  "pathLabels": {
    "hash": "[a-zA-Z0-9-_]+"
  },
  "defaultCompression": "none",
  "files": [
    {
      "path": "assets/BattleFrontierDashboard-<hash>.js",
      "maxSize": "250kb"
    },
    {
      "path": "assets/GlobalRibbonChecklistDashboard-<hash>.js",
      "maxSize": "100kb"
    },
    {
      "path": "assets/PokemonCatchProbability-<hash>.js",
      "maxSize": "25kb"
    },
    {
      "path": "assets/PokemonCaughtDetails-<hash>.js",
      "maxSize": "40kb"
    },
    {
      "path": "assets/PokemonEvolutions-<hash>.js",
      "maxSize": "40kb"
    },
    {
      "path": "assets/PokemonLocations-<hash>.js",
      "maxSize": "30kb"
    },
    {
      "path": "assets/gen1-<hash>.js",
      "maxSize": "20kb"
    },
    {
      "path": "assets/gen2-<hash>.js",
      "maxSize": "25kb"
    },
    {
      "path": "assets/gen3-<hash>.js",
      "maxSize": "30kb"
    },
    {
      "path": "assets/ShinyCarrierBreedingDashboard-<hash>.js",
      "maxSize": "100kb"
    },
    {
      "path": "assets/dag-<hash>.js",
      "maxSize": "200kb"
    },
    {
      "path": "assets/xyflow-<hash>.js",
      "maxSize": "200kb"
    },
    {
      "path": "assets/index-<hash>.js",
      "maxSize": "250kb"
    },
    {
      "path": "assets/react-<hash>.js",
      "maxSize": "250kb"
    },
    {
      "path": "assets/router-<hash>.js",
      "maxSize": "200kb"
    },
    {
      "path": "assets/index-<hash>.css",
      "maxSize": "225kb"
    },
    {
      "path": "assets/*-<hash>.css",
      "maxSize": "50kb"
    },
    {
      "path": "assets/*-<hash>.js",
      "maxSize": "10kb"
    },
    {
      "path": "data/foundry.json",
      "maxSize": "350kb"
    },
    {
      "path": "data/pokedata.msgpack",
      "maxSize": "600kb"
    },
    {
      "path": "icon-512.png",
      "maxSize": "500kb"
    },
    {
      "path": "workbox-<hash>.js",
      "maxSize": "50kb"
    },
    {
      "path": "**/*.@(js|css|html|png|msgpack|webmanifest|json|hash|txt)",
      "maxSize": "300kb"
    }
  ],
  "reportOutput": [
    [
      "github",
      {
        "checkRun": true,
        "commitStatus": true,
        "prComment": true
      }
    ]
  ]
}
